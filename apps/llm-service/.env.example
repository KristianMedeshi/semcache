# LLM Service-specific environment variables.
# Shared backend variables (NODE_ENV, INTERNAL_SERVICE_SECRET, LLM_SERVICE_*)
# are loaded from `../../packages/shared-config/.env.backend` (see `../../packages/shared-config/.env.backend.example`).

# OpenRouter Configuration (free models only: openrouter/free or *:free)
OPENROUTER_API_KEY=replace_with_your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openrouter/free
OPENROUTER_EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
OPENROUTER_TIMEOUT_MS=180000

# Local LLM override for load testing (`openrouter` | `lmstudio` | `transformers`)
LLM_PROVIDER=openrouter
# LM_STUDIO_BASE_URL=http://localhost:1234/v1
# LM_STUDIO_API_KEY=lm-studio
# LM_STUDIO_DEFAULT_MODEL=support-llm
# LM_STUDIO_ALLOWED_MODELS=support-llm,qwen/qwen3-1.7b
# TRANSFORMERS_CHAT_MODEL=onnx-community/Qwen2.5-0.5B-Instruct
# TRANSFORMERS_CHAT_DTYPE=q4
# TRANSFORMERS_CHAT_MAX_NEW_TOKENS=256
