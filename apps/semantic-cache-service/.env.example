# Semantic Cache Service-specific environment overrides.
# Shared backend variables (NODE_ENV, DATABASE_URL, INTERNAL_SERVICE_SECRET, SEMANTIC_CACHE_SERVICE_*)
# are loaded from `../../packages/shared-config/.env.backend` (see `../../packages/shared-config/.env.backend.example`).

# Optional initial defaults used when seeding the persisted `semantic_cache_settings` row:
# SEMANTIC_CACHE_DEFAULT_MODE=adaptive
# SEMANTIC_CACHE_FIXED_THRESHOLD=0.9
# SEMANTIC_CACHE_ADAPTIVE_BASE_THRESHOLD=0.85
# SEMANTIC_CACHE_MIN_ADAPTIVE_THRESHOLD=0.72
# SEMANTIC_CACHE_MAX_ADAPTIVE_THRESHOLD=0.97
# SEMANTIC_CACHE_DENSITY_WEIGHT=0.08
# SEMANTIC_CACHE_DENSITY_K_NEIGHBORS=5
