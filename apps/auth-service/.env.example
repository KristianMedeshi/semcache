# Auth Service-specific environment variables.
# Shared backend variables (NODE_ENV, DATABASE_URL, INTERNAL_SERVICE_SECRET, AUTH_SERVICE_*, CORS_ORIGIN, SESSION_COOKIE_NAME)
# are loaded from `../../packages/shared-config/.env.backend` (see `../../packages/shared-config/.env.backend.example`).

SESSION_TTL=30d
SESSION_IDLE_TIMEOUT=7d
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
SECURE_COOKIES=false
# Optional when NODE_ENV=test (auto-enabled outside Jest unless set to false)
# TEST_BYPASS_SECURITY=true

# Seed Accounts (used only by `pnpm --filter @semcache/auth-service db:seed`)
SEED_CUSTOMER_PASSWORD=ChangeMeCustomer123!
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
