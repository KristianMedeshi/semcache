{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "20",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "TEST_BYPASS_SECURITY",
    "LLM_PROVIDER",
    "LM_STUDIO_BASE_URL",
    "LM_STUDIO_API_KEY",
    "LM_STUDIO_DEFAULT_MODEL",
    "LM_STUDIO_ALLOWED_MODELS",
    "TRANSFORMERS_CHAT_MODEL",
    "TRANSFORMERS_CHAT_DTYPE",
    "TRANSFORMERS_CHAT_MAX_NEW_TOKENS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
