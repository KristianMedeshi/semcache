{
  "name": "semcache",
  "version": "1.0.0",
  "private": true,
  "description": "Microservice customer support system with adaptive LLM semantic response caching",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "jscpd": "jscpd",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yaml,yml}\"",
    "db:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d postgres",
    "db:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "db:logs": "docker compose -f infrastructure/docker/docker-compose.yml logs -f postgres",
    "monitoring:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d prometheus grafana",
    "monitoring:down": "docker compose -f infrastructure/docker/docker-compose.yml stop prometheus grafana",
    "infra:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker/docker-compose.yml down"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@12.18.0",
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "jscpd": "^5.4.3",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11",
    "typescript": "^6.0.2"
  }
}
