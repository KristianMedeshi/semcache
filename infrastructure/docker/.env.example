# Docker Compose PostgreSQL Configuration
POSTGRES_DB=semcache
POSTGRES_USER=semcache_user
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_PORT=5432

# Full-stack application settings (used by `pnpm stack:up`)
APP_NODE_ENV=production
API_GATEWAY_PORT=3000
FRONTEND_PORT=8080
VITE_API_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
INTERNAL_SERVICE_SECRET=replace_with_at_least_32_char_random_secret
SESSION_COOKIE_NAME=semcache_sid
SECURE_COOKIES=false
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=replace_with_your_openrouter_api_key
OPENROUTER_DEFAULT_MODEL=openrouter/free

# Prometheus & Grafana Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3100
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
