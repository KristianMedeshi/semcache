# Environment
NODE_ENV=development

# PostgreSQL Configuration
POSTGRES_DB=semcache
POSTGRES_USER=semcache_user
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_PORT=5432

# Connection URL
DATABASE_URL=postgresql://semcache_user:change_me_in_local_env@localhost:5432/semcache

# Inter-Service TCP Endpoints & Identity Signing
AUTH_SERVICE_HOST=127.0.0.1
AUTH_SERVICE_PORT=3001
DIALOG_SERVICE_HOST=127.0.0.1
DIALOG_SERVICE_PORT=3002
SEMANTIC_CACHE_SERVICE_HOST=127.0.0.1
SEMANTIC_CACHE_SERVICE_PORT=3003
LLM_SERVICE_HOST=127.0.0.1
LLM_SERVICE_PORT=3004
KNOWLEDGE_BASE_SERVICE_HOST=127.0.0.1
KNOWLEDGE_BASE_SERVICE_PORT=3005
# Generate a 32+ character secret before production deployment (e.g., openssl rand -hex 32)
INTERNAL_SERVICE_SECRET=replace_with_at_least_32_char_random_secret

# OpenRouter Configuration (free models only: openrouter/free or *:free)
OPENROUTER_API_KEY=replace_with_your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openrouter/free
OPENROUTER_TIMEOUT_MS=180000

# Session Cookie & Rate-Limiting Configuration
SESSION_COOKIE_NAME=semcache_sid
SESSION_TTL=30d
SESSION_IDLE_TIMEOUT=7d
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
SECURE_COOKIES=false

# Auth Service Seed Accounts (used only by `pnpm --filter @semcache/auth-service db:seed`)
SEED_CUSTOMER_PASSWORD=ChangeMeCustomer123!
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
