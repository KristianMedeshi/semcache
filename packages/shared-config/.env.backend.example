# Shared backend microservice environment variables (loaded as a fallback behind each app's local `.env`).
# Root `.env` is never loaded by apps; copy this file to `.env.backend` (gitignored) in `packages/shared-config/`
# to share common values across backend services without duplicating them in every `apps/*/.env`.

NODE_ENV=development
# Optional in NODE_ENV=test: explicitly toggle CSRF/session/rate-limit bypass for automated load tests
# TEST_BYPASS_SECURITY=true

# Shared PostgreSQL connection URL (auth-service, dialog-service, semantic-cache-service, knowledge-base-service)
DATABASE_URL=postgresql://semcache_user:change_me_in_local_env@localhost:5432/semcache

# Shared internal identity signing secret (all backend microservices)
# Generate a 32+ character secret before production deployment (e.g., openssl rand -hex 32)
INTERNAL_SERVICE_SECRET=replace_with_at_least_32_char_random_secret

# Shared inter-service TCP endpoints
AUTH_SERVICE_HOST=127.0.0.1
AUTH_SERVICE_PORT=3001
DIALOG_SERVICE_HOST=127.0.0.1
DIALOG_SERVICE_PORT=3002
SEMANTIC_CACHE_SERVICE_HOST=127.0.0.1
SEMANTIC_CACHE_SERVICE_PORT=3003
LLM_SERVICE_HOST=127.0.0.1
LLM_SERVICE_PORT=3004
KNOWLEDGE_BASE_SERVICE_HOST=127.0.0.1
KNOWLEDGE_BASE_SERVICE_PORT=3005

# Shared session cookie & CORS settings (api-gateway, auth-service)
SESSION_COOKIE_NAME=change_me_in_local_env
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
